# ============================================================
#  GEMINI GOLD EYE - MODELE DE CONFIGURATION
# ============================================================
# 1. Copiez ce fichier :  cp .env.example .env
# 2. Remplissez VOS valeurs ci-dessous.
# 3) NE JAMAIS committer le vrai .env (il est dans .gitignore).
#    Ne partagez JAMAIS vos mots de passe dans un chat.
# ============================================================

# --- IA ---
# Plusieurs cles Gemini = rotation automatique en cas de quota (recommande).
# Cree plusieurs cles gratuites sur https://aistudio.google.com/ et separe-les par des virgules.
GEMINI_API_KEYS=cle_api_gemini_1,cle_api_gemini_2,cle_api_gemini_3
# (retro-compatible: une seule cle via GEMINI_API_KEY=... fonctionne aussi)

# --- META TRADER 5 ---
# A inserer UNIQUEMENT dans votre .env local (jamais dans le code)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
# Optionnel : chemin complet du terminal MT5 si autodetection echoue
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- OANDA (broker cloud, SANS MT5 / SANS VPS) ---
# Cree un compte pratique gratuit sur oanda.com -> Settings -> API Access -> token
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=True

# --- SYMBOLES & RISQUE ---
SYMBOLS_LIST=AUDCAD,USDJPY,USDCHF,XAUUSD
RISK_PER_TRADE=1.0
MODE_SNIPER=True
BE_TRIGGER=300
TRAILING_DIST=300

# --- PROTECTION COMPTE PROP-FIRM (circuit-breaker) ---
# Perte journaliere max en % du solde -> arret total jusqu'au lendemain
MAX_DAILY_LOSS_PCT=4.0
# Nombre max de trades par jour
MAX_DAILY_TRADES=5
# Nombre max de pertes consecutives -> pause
MAX_CONSEC_LOSSES=3
# Identifiant unique des ordres du bot (magic number)
MAGIC_NUMBER=777888
